<?xml version="1.0" encoding="utf-8"?>
<!-- [Jalur Class]: /app/src/main/res/layout/item_settings_parent.xml -->
<!-- [Penjelasan]: Tampilan item Parent Node TreeView untuk kategori utama Pengaturan yang dapat di-expand/collapse -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/parentContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_settings_card_parent"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Category Icon Container -->
    <ImageView
        android:id="@+id/ivParentIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="14dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_grid" />

    <!-- Text Information -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvParentTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grid &amp; Tata Letak"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvParentSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Pengaturan baris, kolom, dan spasi ikon"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Expand / Collapse Indicator Chevron -->
    <ImageView
        android:id="@+id/ivExpandChevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_expand_more" />

</LinearLayout>
