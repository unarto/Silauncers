<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal|top"
    android:orientation="vertical"
    android:background="?android:attr/selectableItemBackgroundBorderless">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/default_icon_spacing">
        
        <FrameLayout
            android:id="@+id/folder_preview_container"
            android:layout_width="@dimen/default_icon_size"
            android:layout_height="@dimen/default_icon_size"
            android:background="@drawable/bg_folder_preview"
            android:clipToOutline="true">

            <!-- [Jalur Class]: app/src/main/res/layout/view_folder_icon.xml -->
            <!-- [Penjelasan]: Grid mini 3x3 untuk menampilkan hingga 9 thumbnail ikon aplikasi di dalam preview folder icon sesuai Screenshot 2 -->
            <GridLayout
                android:id="@+id/folder_preview_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:columnCount="3"
                android:rowCount="3"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="false"
                android:padding="@dimen/folder_preview_padding">

                <ImageView
                    android:id="@+id/preview_icon_0"
                    android:layout_width="@dimen/folder_preview_item_size"
                    android:layout_height="@dimen/folder_preview_item_size"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/folder_preview_item_margin"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/preview_icon_1"
                    android:layout_width="@dimen/folder_preview_item_size"
                    android:layout_height="@dimen/folder_preview_item_size"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/folder_preview_item_margin"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/preview_icon_2"
                    android:layout_width="@dimen/folder_preview_item_size"
                    android:layout_height="@dimen/folder_preview_item_size"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/folder_preview_item_margin"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/preview_icon_3"
                    android:layout_width="@dimen/folder_preview_item_size"
                    android:layout_height="@dimen/folder_preview_item_size"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/folder_preview_item_margin"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/preview_icon_4"
                    android:layout_width="@dimen/folder_preview_item_size"
                    android:layout_height="@dimen/folder_preview_item_size"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/folder_preview_item_margin"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/preview_icon_5"
                    android:layout_width="@dimen/folder_preview_item_size"
                    android:layout_height="@dimen/folder_preview_item_size"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/folder_preview_item_margin"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/preview_icon_6"
                    android:layout_width="@dimen/folder_preview_item_size"
                    android:layout_height="@dimen/folder_preview_item_size"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/folder_preview_item_margin"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/preview_icon_7"
                    android:layout_width="@dimen/folder_preview_item_size"
                    android:layout_height="@dimen/folder_preview_item_size"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/folder_preview_item_margin"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/preview_icon_8"
                    android:layout_width="@dimen/folder_preview_item_size"
                    android:layout_height="@dimen/folder_preview_item_size"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/folder_preview_item_margin"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
            </GridLayout>
        </FrameLayout>

        <View
            android:id="@+id/folder_notification_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_notification_dot"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/folder_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center_horizontal|top"
        android:maxLines="2"
        android:minLines="2"
        android:textColor="@android:color/white"
        android:shadowColor="#80000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:textSize="@dimen/default_label_size" />

</LinearLayout>
