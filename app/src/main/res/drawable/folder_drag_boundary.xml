<?xml version="1.0" encoding="utf-8"?>
<!--
  // [Jalur Class]: app/src/main/res/drawable/folder_drag_boundary.xml
  // [Penjelasan]: Visual boundary indicator berupa garis putus-putus berbingkai lembut yang menandai batas area keluar transisi Folder -> Workspace saat item sedang diseret
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#10FFFFFF" />
    <stroke
        android:width="2dp"
        android:color="#B3FFFFFF"
        android:dashWidth="8dp"
        android:dashGap="6dp" />
    <corners android:radius="28dp" />
</shape>
