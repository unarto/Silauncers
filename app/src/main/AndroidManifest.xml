<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- [Jalur Class]: /app/src/main/AndroidManifest.xml -->
    <!-- [Penjelasan]: Izin untuk membaca wallpaper aktif perangkat melalui WallpaperManager -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:name=".launcher.LauncherApplication"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Silauncer">
        
        <activity
            android:name=".launcher.LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Theme.Silauncer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity android:name=".settings.SettingsActivity" android:exported="false" android:theme="@style/Theme.Silauncer.Settings" />
        
        <!-- [Jalur Class]: /app/src/main/AndroidManifest.xml -->
        <!-- [Penjelasan]: Mendaftarkan SecondaryDisplayLauncher untuk mendukung tampilan antarmuka launcher pada layar sekunder (Secondary Display / External Display / Desktop Mode) -->
        <activity
            android:name=".secondarydisplay.SecondaryDisplayLauncher"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Theme.Silauncer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- [Jalur Class]: /app/src/main/AndroidManifest.xml -->
        <!-- [Penjelasan]: Mendaftarkan NotificationListenerService untuk mendengarkan perubahan status notifikasi Android dan mengendalikan notification dots / popup -->
        <service
            android:name=".notification.NotificationListener"
            android:label="@string/notifications_header"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
